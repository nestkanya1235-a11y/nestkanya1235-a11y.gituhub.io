<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kanyawee Srisit — Artist & Graphic Designer</title>
  <meta name="description" content="Portfolio of Kanyawee Srisit (Nest), Artist and Graphic Designer." />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Patrick+Hand&family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root{
      --paper:#f5f0df;
      --ink:#171717;
      --muted:#6f6b60;
      --yellow:#f7ca3d;
      --pink:#f45d91;
      --mint:#9adcc7;
      --blue:#4267d5;
      --orange:#f28a55;
      --shadow: 0 14px 35px rgba(35,31,25,.16);
      --line: rgba(75,72,65,.16);
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      color:var(--ink);
      background:
        linear-gradient(90deg, transparent 0 6%, rgba(245,240,223,.72) 6% 94%, transparent 94%),
        repeating-linear-gradient(0deg, #8e908f 0 1px, #9b9d9c 1px 30px);
      font-family:"Space Grotesk",system-ui,sans-serif;
      overflow-x:hidden;
    }

    body:before{
      content:"";
      position:fixed; inset:0; pointer-events:none; z-index:20;
      background-image:radial-gradient(rgba(0,0,0,.08) .55px, transparent .55px);
      background-size:5px 5px; opacity:.18;
    }

    .page{
      width:min(1180px, 94vw);
      margin:22px auto;
      background:
        repeating-linear-gradient(0deg, transparent 0 34px, var(--line) 35px),
        var(--paper);
      min-height:100vh;
      box-shadow:0 0 0 1px rgba(0,0,0,.18), var(--shadow);
      position:relative;
      overflow:hidden;
    }

    nav{
      height:64px;
      display:flex; align-items:center; gap:8px;
      padding:0 18px;
      border-bottom:1px solid rgba(0,0,0,.18);
      position:sticky; top:0; z-index:15;
      background:rgba(245,240,223,.94);
      backdrop-filter:blur(8px);
    }
    .logo-dot{
      width:25px;height:25px;border-radius:50%;
      background:var(--pink); display:grid;place-items:center;
      font-weight:700; font-size:12px; transform:rotate(-8deg);
      margin-right:10px;
    }
    nav a{
      color:var(--ink); text-decoration:none;
      padding:10px 13px; border-radius:4px;
      font:600 12px "IBM Plex Mono",monospace;
      letter-spacing:.04em;
    }
    nav a.active{background:var(--yellow)}
    nav a:hover{background:rgba(247,202,61,.55)}
    .nav-spacer{flex:1}
    .socials{display:flex;gap:7px}
    .socials span{
      width:22px;height:22px;border-radius:50%;display:grid;place-items:center;
      border:1px solid #222;font-size:10px;font-weight:700;
    }
    .contact-btn{
      margin-left:9px;padding:9px 13px;border:1px solid #222;
      background:white;font:600 11px "IBM Plex Mono",monospace;
      cursor:pointer;
    }

    .hero{
      min-height:700px; position:relative; padding:62px 7% 40px;
      display:grid; place-items:center;
      isolation:isolate;
    }
    .hero-copy{position:relative; z-index:4; text-align:center; max-width:760px}
    .tiny-note{
      font:17px "Patrick Hand",cursive;
      transform:rotate(-3deg); display:inline-block; margin-bottom:12px;
    }
    .name-card{
      display:inline-block;
      position:relative; padding:18px 36px 14px;
      border:2px solid var(--orange);
      background:rgba(255,253,246,.78);
      transform:rotate(-1.4deg);
    }
    .name-card:before{
      content:"ARTIST & GRAPHIC DESIGNER"; position:absolute;
      left:-82px; bottom:-17px; background:var(--yellow);
      padding:8px 12px; font:600 9px "IBM Plex Mono",monospace;
      transform:rotate(-5deg);
    }
    .name-card h1{
      margin:0; font:700 clamp(54px,8vw,105px)/.85 "IBM Plex Mono",monospace;
      letter-spacing:-.1em;
    }
    .name-card .sub{
      margin-top:12px; font:13px "IBM Plex Mono",monospace; letter-spacing:.04em;
    }
    .hero h2{
      margin:35px auto 20px; max-width:700px;
      font-size:clamp(31px,4.2vw,58px); line-height:.98;
      letter-spacing:-.055em;
    }
    .hero h2 em{font-style:normal; text-decoration:underline wavy var(--pink) 4px}
    .cta{
      border:0; background:#181818; color:white; padding:14px 22px;
      font:600 12px "IBM Plex Mono",monospace; cursor:pointer;
      box-shadow:5px 5px 0 var(--blue);
      transition:.2s;
    }
    .cta:hover{transform:translate(2px,2px);box-shadow:3px 3px 0 var(--blue)}

    .sticker{
      position:absolute; padding:9px 14px; font:600 11px "IBM Plex Mono",monospace;
      box-shadow:2px 4px 0 rgba(0,0,0,.08); z-index:3;
    }
    .sticker.mint{background:var(--mint)}
    .sticker.yellow{background:var(--yellow)}
    .s1{top:105px;left:16%;transform:rotate(-2deg)}
    .s2{top:118px;right:15%;transform:rotate(3deg)}
    .doodle{
      position:absolute; width:58px;height:58px;border:3px solid var(--pink);
      border-radius:50%; opacity:.9;
    }
    .doodle:after{content:"✦";position:absolute;left:16px;top:9px;font-size:25px}
    .d1{left:9%;top:45%;transform:rotate(12deg)}
    .d2{right:9%;top:48%;border-color:var(--orange);transform:rotate(-14deg)}

    #scene{
      position:absolute; inset:0; z-index:1; width:100%; height:100%;
    }
    .scene-hint{
      position:absolute; bottom:24px; right:26px; z-index:5;
      font:11px "IBM Plex Mono",monospace; background:rgba(255,255,255,.75);
      padding:8px 10px; border:1px solid #222;
    }

    section{padding:86px 7%; position:relative}
    .section-label{font:14px "Patrick Hand",cursive; margin-bottom:8px}
    .section-title{
      font:700 clamp(46px,7vw,88px)/.9 "IBM Plex Mono",monospace;
      letter-spacing:-.08em; margin:0 0 35px;
    }

    .about-grid{
      display:grid; grid-template-columns:280px 1fr; gap:45px; align-items:start;
    }
    .photo-card{
      background:#fff; padding:12px 12px 32px; box-shadow:var(--shadow);
      transform:rotate(-3deg); position:relative;
    }
    .photo-card .portrait{
      height:300px; display:grid;place-items:center;
      background:
        radial-gradient(circle at 65% 34%, #f4d0aa 0 13%, transparent 13.5%),
        linear-gradient(135deg,#55747d,#1d2930 52%,#bd7a45);
      color:white; font:14px "IBM Plex Mono",monospace;
      overflow:hidden;
    }
    .photo-card .portrait:after{
      content:"NEST"; font:700 48px "IBM Plex Mono",monospace;
      opacity:.18; transform:rotate(-90deg);
    }
    .tape{
      position:absolute; width:85px;height:22px;background:rgba(225,218,171,.75);
      top:-10px;left:88px;transform:rotate(-5deg);
    }
    .caption{font:17px "Patrick Hand",cursive;text-align:center;margin-top:9px}
    .about-copy{
      font:25px/1.35 "Patrick Hand",cursive;
      max-width:720px;
    }
    .about-copy strong{font-family:"Space Grotesk",sans-serif;font-size:15px}
    .skill-wrap{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
    .skill{
      padding:9px 15px;font:600 12px "IBM Plex Mono",monospace;
      transform:rotate(var(--r)); box-shadow:2px 3px 0 rgba(0,0,0,.1);
    }
    .skill:nth-child(4n+1){background:var(--yellow)}
    .skill:nth-child(4n+2){background:var(--pink);color:white}
    .skill:nth-child(4n+3){background:var(--blue);color:white}
    .skill:nth-child(4n){background:var(--mint)}

    .projects{
      background:#151311; color:#f7f2e5;
      margin:0 4%; padding:55px 5%;
      position:relative; overflow:hidden;
    }
    .projects:before{
      content:""; position:absolute;inset:0;
      background:repeating-linear-gradient(0deg,transparent 0 33px,rgba(255,255,255,.06) 34px);
      pointer-events:none;
    }
    .projects .section-title{color:white}
    .project-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;position:relative}
    .project{
      min-height:280px;padding:27px;position:relative;overflow:hidden;
      background:#f6ca3f;color:#181818; box-shadow:8px 8px 0 #000;
      transition:.25s; cursor:pointer;
    }
    .project:nth-child(2){background:#f4f0df}
    .project:nth-child(3){background:#4267d5;color:white}
    .project:nth-child(4){background:#f45d91;color:white}
    .project:hover{transform:translateY(-7px) rotate(-.6deg)}
    .project small{font:600 10px "IBM Plex Mono",monospace}
    .project h3{font:700 42px/1 "IBM Plex Mono",monospace;margin:28px 0 12px;letter-spacing:-.08em}
    .project p{font:16px "Patrick Hand",cursive;max-width:360px}
    .project .shape{
      position:absolute;width:180px;height:130px;right:-25px;bottom:-20px;
      border-radius:18px 18px 0 0;border:8px solid rgba(0,0,0,.14);
      transform:rotate(-8deg);
      background:linear-gradient(135deg,rgba(255,255,255,.6),rgba(0,0,0,.18));
    }
    .project .shape:after{
      content:"";position:absolute;inset:22px 15px;
      border:2px dashed rgba(0,0,0,.35);border-radius:9px;
    }

    .timeline{
      display:grid;grid-template-columns:1fr 1fr;gap:30px;
    }
    .note{
      background:#fffdf5;padding:30px;box-shadow:var(--shadow);
      border:1px solid rgba(0,0,0,.1);transform:rotate(-1deg);
    }
    .note:nth-child(even){transform:rotate(1.4deg);background:#fff3b9}
    .note h3{font:700 26px "IBM Plex Mono",monospace;margin:0 0 14px}
    .note p{font:19px/1.35 "Patrick Hand",cursive;margin:0;color:#45423b}
    .note .date{font:10px "IBM Plex Mono",monospace;font-weight:600}

    .contact{
      min-height:480px;text-align:center;display:grid;place-items:center;
      padding-bottom:100px;
    }
    .contact-box{
      width:min(720px,100%); background:var(--yellow);padding:55px 30px;
      box-shadow:12px 12px 0 #171717; transform:rotate(-1deg);
    }
    .contact-box h2{font:700 clamp(44px,7vw,82px)/.9 "IBM Plex Mono",monospace;letter-spacing:-.08em;margin:0 0 18px}
    .contact-box p{font:23px "Patrick Hand",cursive;margin:0 0 25px}
    .contact-box a{color:#111;font:600 12px "IBM Plex Mono",monospace;text-decoration:none;border-bottom:2px solid #111}

    footer{padding:22px 7%;border-top:1px solid rgba(0,0,0,.15);font:10px "IBM Plex Mono",monospace;display:flex;justify-content:space-between}

    .modal{
      position:fixed;inset:0;background:rgba(12,11,9,.72);z-index:30;
      display:none;place-items:center;padding:25px;
    }
    .modal.open{display:grid}
    .modal-card{
      max-width:700px;background:var(--paper);padding:36px;
      border:3px solid #111;box-shadow:14px 14px 0 var(--yellow);
      position:relative;
    }
    .modal-card h3{font:700 38px "IBM Plex Mono",monospace;margin:0 0 12px}
    .modal-card p{font:20px "Patrick Hand",cursive;line-height:1.35}
    .close{position:absolute;right:12px;top:10px;border:0;background:none;font-size:25px;cursor:pointer}

    @media(max-width:760px){
      body{background:#8f9190}
      .page{width:100%;margin:0}
      nav{gap:0;padding:0 9px}
      nav a{padding:8px 7px;font-size:9px}
      .socials{display:none}
      .contact-btn{font-size:9px;padding:8px}
      .hero{min-height:610px;padding:45px 5%}
      .name-card{padding:15px 18px}
      .name-card:before{left:-10px;bottom:-28px}
      .about-grid,.timeline,.project-grid{grid-template-columns:1fr}
      .about-grid{gap:28px}
      .photo-card{width:min(300px,90%);margin:auto}
      section{padding:65px 6%}
      .projects{margin:0;padding:48px 6%}
      .project{min-height:240px}
      .scene-hint{font-size:9px;right:10px}
    }
  </style>
</head>
<body>
  <div class="page">
    <nav>
      <div class="logo-dot">✦</div>
      <a href="#home" class="active">★ HOME</a>
      <a href="#about">▦ ABOUT</a>
      <a href="#notes">✦ NOTES</a>
