  <div class="modal" id="modal" onclick="if(event.target===this)closeProject()">
    <div class="modal-card">
      <button class="close" onclick="closeProject()">×</button>
      <h3 id="modalTitle"></h3>
      <p id="modalText"></p>
      <button class="cta" onclick="closeProject()">BACK TO NOTEBOOK</button>
    </div>
  </div>

  <!-- Three.js: loaded from CDN so this remains a single HTML file. -->
  <script type="module">
    import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.176.0/build/three.module.js';
    import { OrbitControls } from 'https://cdn.jsdelivr.net/npm/three@0.176.0/examples/jsm/controls/OrbitControls.js';

    const canvas = document.getElementById('scene');
    const renderer = new THREE.WebGLRenderer({canvas, antialias:true, alpha:true});
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
    camera.position.set(0, 1.1, 7.2);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.enablePan = false;
    controls.minDistance = 5.2;
    controls.maxDistance = 9;
    controls.minPolarAngle = Math.PI * .30;
    controls.maxPolarAngle = Math.PI * .67;
    controls.target.set(0, .25, 0);

    scene.add(new THREE.HemisphereLight(0xfff7df, 0x514a40, 2.5));
    const key = new THREE.DirectionalLight(0xffffff, 3.2);
    key.position.set(3,5,4); scene.add(key);
    const rim = new THREE.PointLight(0xf7ca3d, 20, 12);
    rim.position.set(-3,2,2); scene.add(rim);

    const mat = (color, rough=.65, metal=0) =>
      new THREE.MeshStandardMaterial({color, roughness:rough, metalness:metal});

    // Notebook desk
    const desk = new THREE.Mesh(new THREE.BoxGeometry(6.8,.18,4.4), mat(0xf5f0df));
    desk.position.y=-1.18; scene.add(desk);

    // Spiral rings
    const ringMat = mat(0x222222,.35,.45);
    for(let x=-2.65;x<=2.65;x+=.42){
      const ring = new THREE.Mesh(new THREE.TorusGeometry(.11,.035,8,18,Math.PI*1.25), ringMat);
      ring.rotation.x=Math.PI/2; ring.position.set(x,-1.02,-2.08); scene.add(ring);
    }

    // Laptop
    const laptopGroup = new THREE.Group();
    const base = new THREE.Mesh(new THREE.BoxGeometry(2.55,.12,1.7), mat(0x252525,.35,.25));
    base.position.y=-.82; laptopGroup.add(base);
    const screen = new THREE.Mesh(new THREE.BoxGeometry(2.48,1.48,.09), mat(0x111111,.25,.2));
    screen.position.set(0,.02,-.72); screen.rotation.x=-.14; laptopGroup.add(screen);

    const screenGlow = new THREE.Mesh(
      new THREE.PlaneGeometry(2.18,1.17),
      new THREE.MeshBasicMaterial({color:0xf6ca3f})
    );
    screenGlow.position.set(0,.02,-.775); screenGlow.rotation.x=-.14; laptopGroup.add(screenGlow);

    // Screen "UI" cards
    for(let i=0;i<4;i++){
      const card = new THREE.Mesh(
        new THREE.PlaneGeometry(.43,.14),
        new THREE.MeshBasicMaterial({color:[0x171717,0xf45d91,0x4267d5,0x9adcc7][i]})
      );
      card.position.set(-.75+i*.5,.18,-.785); card.rotation.x=-.14; laptopGroup.add(card);
    }
    laptopGroup.rotation.y=-.24;
    laptopGroup.position.set(.15,-.02,.05);
    scene.add(laptopGroup);

    // Sticky notes
    const noteColors=[0xf7ca3d,0xf45d91,0x9adcc7,0x4267d5];
    const notes=[];
    for(let i=0;i<4;i++){
      const n = new THREE.Mesh(new THREE.BoxGeometry(.95,.035,.72), mat(noteColors[i],.9));
      n.position.set(-2.0+i*1.0,-.96,-.75+(i%2)*.2);
      n.rotation.y=(i-1.5)*.16;
      n.rotation.x=.02;
      scene.add(n); notes.push(n);
    }

    // Pencil cup
    const cup = new THREE.Mesh(new THREE.CylinderGeometry(.36,.3,.75,24), mat(0x4267d5));
    cup.position.set(2.15,-.55,-.35); scene.add(cup);
    for(let i=0;i<5;i++){
      const pencil = new THREE.Mesh(new THREE.CylinderGeometry(.035,.035,1.6,8), mat([0xf7ca3d,0xf45d91,0x171717][i%3]));
      pencil.position.set(2.02+i*.08,-.02,-.35);
      pencil.rotation.z=(i-2)*.09;
      scene.add(pencil);
    }

    // 3D "paper" cards hovering behind laptop
    const cardGroup = new THREE.Group();
    for(let i=0;i<3;i++){
      const card = new THREE.Mesh(new THREE.BoxGeometry(1.55,.045,1.12), mat([0xf7ca3d,0xf5f0df,0xf45d91][i],.8));
      card.position.set(-1.75+i*1.45,.2,-.95);
      card.rotation.set(-.05,(i-1)*.16,(i-1)*.09);
      cardGroup.add(card);
    }
    cardGroup.position.y=.25;
    scene.add(cardGroup);

    // Floating little flower/star
    const star = new THREE.Mesh(new THREE.TorusKnotGeometry(.22,.055,80,10), mat(0xf45d91,.45,.05));
    star.position.set(-2.35,1.0,.1);
    scene.add(star);

    function resize(){
      const rect=canvas.getBoundingClientRect();
      const w=Math.max(1,rect.width), h=Math.max(1,rect.height);
      renderer.setSize(w,h,false);
      camera.aspect=w/h; camera.updateProjectionMatrix();
    }
    addEventListener('resize',resize); resize();

    let t=0;
    function animate(){
      requestAnimationFrame(animate); t+=.01;
      controls.update();
      star.rotation.x=t*.8; star.rotation.y=t;
      cardGroup.position.y=.25+Math.sin(t*1.4)*.045;
      notes.forEach((n,i)=> n.position.y=-.96+Math.sin(t*1.1+i)*.018);
      renderer.render(scene,camera);
    }
    animate();
  </script>

  <script>
    function openProject(title,text){
      document.getElementById('modalTitle').textContent=title;
      document.getElementById('modalText').textContent=text;
      document.getElementById('modal').classList.add('open');
    }
    function closeProject(){document.getElementById('modal').classList.remove('open')}
    document.addEventListener('keydown',e=>{if(e.key==='Escape')closeProject()});

    const links=[...document.querySelectorAll('nav a')];
    const sections=[...document.querySelectorAll('main section[id]')];
    const io=new IntersectionObserver(entries=>{
      entries.forEach(entry=>{
        if(entry.isIntersecting){
          links.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+entry.target.id));
        }
      })
    },{threshold:.45});
    sections.forEach(s=>io.observe(s));
  </script>
</body>
</html>
